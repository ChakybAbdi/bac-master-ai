# BAC MASTER AI - configuration
# Copy this file to .env (or run `npm run setup`, which also generates a random admin password).

# --- Server ---------------------------------------------------------------
PORT=8787
# Folder that holds the SQLite database.
DATA_DIR=./data
# Folder where the monitoring agent writes records.json and reports/.
MONITORING_DIR=./monitoring
# Set to true when the app is served over HTTPS (adds the Secure flag to the session cookie).
COOKIE_SECURE=false

# --- First administrator ----------------------------------------------------
# Created at startup when the database has no administrator yet.
ADMIN_EMAIL=admin@bacmaster.local
ADMIN_PASSWORD=
ADMIN_NAME=Administrateur

# --- AI tutor (optional) ----------------------------------------------------
# Without a key the tutor still works, but answers only with passages from the
# verified knowledge base (no generated explanation).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
TUTOR_EFFORT=medium

# --- Local model (Ollama) ---------------------------------------------------
# An open model running on this computer through Ollama (https://ollama.com).
# Used when no Claude key is set, or always with TUTOR_PROVIDER=local.
# TUTOR_PROVIDER: local | anthropic | none (empty = automatic)
TUTOR_PROVIDER=local
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://127.0.0.1:11434
# Reasoning mode: slower, noticeably more accurate in maths and physics.
OLLAMA_THINK=true
# 12288 keeps a 9B model entirely on an 8 GB GPU (about 4x faster than spilling to the CPU).
OLLAMA_NUM_CTX=12288

# Questions a student can ask the tutor per day (0 = no limit).
TUTOR_DAILY_LIMIT=40
